{
  "expo": {
    "name": "Pilly",
    "slug": "Pilly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icons/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Pilly",
      "config": {
        "googleMapsApiKey": "AIzaSyCBMKCiDABaYr0d4L5FVT8gtaLPZFSF2Y8"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.Pilly",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCBMKCiDABaYr0d4L5FVT8gtaLPZFSF2Y8"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Pilly precisa da sua localização para encontrar farmácias próximas."
        }
      ]
    ]
  }
}
